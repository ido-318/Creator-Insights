ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
MODEL=anthropic/claude-sonnet-4-6
CREWAI_TRACING_ENABLED=false

# Optional override: use a random URL-safe token (32+ characters).
# When unset, the app creates a private .streamlit/access_token automatically.
# CREATOR_INSIGHTS_ACCESS_TOKEN=

# Optional Supabase connection (server only; never put these in the UI)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
